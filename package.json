{
	"name": "server",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"type-check": "cd backend && tsc --noEmit",
		"lint": "biome lint --write",
		"backend:build": "cd backend && tsc --build",
		"backend:dev": "cd backend && bun run dev",
		"format:check": "biome format --write",
		"format": "biome check --write",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc}": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"add": "2.0.9",
		"bun": "1.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1"
	}
}
